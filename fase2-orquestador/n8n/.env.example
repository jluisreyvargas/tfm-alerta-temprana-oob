# Copiar a .env en este mismo directorio. Excluido por .gitignore (**/.env).
#
# docker-compose.yml lo carga con env_file (lineas 6-7). Todos los valores se
# dejan VACIOS a proposito: un marcador de relleno arranca igual y sobrevive al
# despliegue (leccion del P0-3). Inventario completo de estas variables en
# docs/despliegue/INVENTARIO-despliegue.md, seccion 1.3.

# --- Generables: se crean antes de arrancar nada -----------------------------

# Clave de cifrado de las credenciales de n8n. Generable: openssl rand -hex 32
# No coincide con ningun otro fichero. NO esta en el bloque environment del
# compose: llega al contenedor solo por env_file. Si falta, n8n genera una en
# el volumen y rotarla despues obliga a exportar las credenciales en claro.
N8N_ENCRYPTION_KEY=

# Secreto HMAC del webhook wazuh-alerts. Generable: openssl rand -hex 32
# Debe coincidir con WEBHOOK_SECRET de /var/ossec/etc/n8n-integration.conf en
# el manager de Wazuh (plantilla: ../wazuh-integration/n8n-integration.conf.example).
# NO esta en el bloque environment del compose: llega solo por env_file.
OOB_WEBHOOK_SECRET=

# Secreto HMAC de POST /velociraptor/collect. Generable: openssl rand -hex 32
# Debe coincidir con ORCH_HMAC_SECRET de fase5-orchestrator-api/.env.
# El compose aborta con :? si falta (docker-compose.yml:29).
ORCH_HMAC_SECRET=

# Bearer token del agente del DC. Generable: openssl rand -hex 32
# Debe coincidir con AGENT_TOKEN del servicio NSSM TFM-DC-Agent en DC01
# (fase4-breakglass-dc/dcagent/README-despliegue.md) y con scripts/dc-signed.env.
AGENT_TOKEN=

# Secreto HMAC del canal n8n -> agente del DC. Generable: openssl rand -hex 32
# Debe coincidir con AGENT_HMAC_SECRET del servicio NSSM en DC01 y con
# scripts/dc-signed.env.
AGENT_HMAC_SECRET=

# --- Se obtienen de Rocket.Chat: solo existen con el servicio arrancado ------

# Identificador (_id) del usuario orchestrator-bot. Se obtiene de Rocket.Chat.
# Es el mismo identificador que los workflows llevan como literal en la
# cabecera X-User-Id de sus nodos HTTP Request.
RC_BOT_USER_ID=

# Token de acceso personal de orchestrator-bot, generado con omision de 2FA.
# Se obtiene de Rocket.Chat. Es el mismo token que guarda la credencial
# rocketchatApi ("Rocket account") de n8n.
RC_BOT_TOKEN=

# Token del webhook saliente de Rocket.Chat que entrega los comandos !ir.
# Se obtiene de Rocket.Chat (integracion saliente hacia /webhook/rc-breakglass).
# Debe coincidir con el token configurado en esa integracion.
RC_OUTGOING_TOKEN=

# Identificadores (_id) de Rocket.Chat de los aprobadores, separados por comas,
# sin espacios obligatorios (el workflow hace split(',') y trim).
# Se obtienen de Rocket.Chat, uno por cada usuario autorizado a aprobar.
IR_APPROVER_IDS=
