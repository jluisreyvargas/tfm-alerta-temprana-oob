# Copiar a .env en este mismo directorio. .env esta excluido por .gitignore.
#
# Las variables de credencial se dejan VACIAS a proposito. Rellenarlas con
# valores generados; NUNCA con los de .env.model (plantilla upstream), que son
# constantes publicas del repositorio de DFIR-IRIS. Ver SECURITY-NOTICE.md y
# docs/INFORME-AUDITORIA-FASE6.md (P0-E).

# -- COMMON
LOG_LEVEL=info

# -- NGINX
NGINX_IMAGE_NAME=ghcr.io/dfir-iris/iriswebapp_nginx
NGINX_IMAGE_TAG=v2.4.27
SERVER_NAME=iris.oob.local
KEY_FILENAME=iris_oob_key.pem
CERT_FILENAME=iris_oob_cert.pem

# -- DATABASE
DB_IMAGE_NAME=ghcr.io/dfir-iris/iriswebapp_db
DB_IMAGE_TAG=v2.4.27
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_ADMIN_USER=raptor
POSTGRES_ADMIN_PASSWORD=
POSTGRES_DB=iris_db
POSTGRES_SERVER=db
POSTGRES_PORT=5432

# -- IRIS
APP_IMAGE_NAME=ghcr.io/dfir-iris/iriswebapp_app
APP_IMAGE_TAG=v2.4.27
DOCKERIZED=1
# openssl rand -base64 48 | tr -d '\n'   Firma la cookie de sesion de Flask.
IRIS_SECRET_KEY=
# openssl rand -base64 32 | tr -d '\n'   Residual: se carga pero no se consume;
# el hashing es bcrypt con salt por contrasena. Ver P1-8.
IRIS_SECURITY_PASSWORD_SALT=
IRIS_UPSTREAM_SERVER=app
IRIS_UPSTREAM_PORT=8000

# -- WORKER
CELERY_BROKER=amqp://rabbitmq

# -- AUTH
IRIS_AUTHENTICATION_TYPE=local
IRIS_ADM_EMAIL=admin@iris.oob.local
IRIS_ADM_USERNAME=administrator
# Solo se aplica al inicializar una BD vacia. Comentar tras el primer arranque.
# IRIS_ADM_PASSWORD=

# -- LISTENING PORT
# El override publica en 100.64.0.1:${INTERFACE_HTTPS_PORT}
INTERFACE_HTTPS_PORT=4833
