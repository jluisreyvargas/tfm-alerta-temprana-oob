[Unit]
Description=TFM Fase 6 - DFIR-IRIS (arranque limpio via Compose)
Documentation=https://github.com/jluisreyvargas/tfm-alerta-temprana-oob
Requires=docker.service
After=docker.service tailscaled.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/home/jose/tfm-alerta-temprana-oob/fase6-iris
User=jose
Group=jose
# down + up garantiza endpoints de red nuevos y que Compose honre
# depends_on y el healthcheck, que el demonio ignora al restaurar.
# iriswebapp_nginx publica en 100.64.0.1 (docker-compose.override.yml:27).
# Esa IP solo existe cuando tailscaled ha contactado con Headscale, contenedor
# del propio enclave: After=tailscaled.service no basta. Medido el 2026-09-24:
# la unidad arrancó 27 s antes de que existiera la IP y funcionó solo porque
# la cadena de depends_on retrasó a nginx. Se espera a la IP (máx. 300 s).
# Si cambia la IP en el override, hay que cambiarla aquí.
ExecStartPre=/bin/sh -c 'i=0; while [ $$i -lt 150 ]; do ip -4 -o addr show | grep -q " 100.64.0.1/" && exit 0; i=$$((i+1)); sleep 2; done; echo "100.64.0.1 no disponible tras 300 s" >&2; exit 1'
ExecStart=/usr/bin/docker compose down --remove-orphans
ExecStart=/usr/bin/docker compose up -d --wait --wait-timeout 180
ExecStop=/usr/bin/docker compose down
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
