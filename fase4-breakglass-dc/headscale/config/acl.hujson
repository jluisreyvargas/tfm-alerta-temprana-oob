// Microsegmentación del enclave OOB.
// Sin política, Headscale aplica "allow all": un DC comprometido
// alcanzaría n8n, Wazuh, MISP e IRIS.
// Validar: docker exec headscale headscale policy check --file /etc/headscale/acl.hujson
// NOTA v0.28: los usuarios se referencian con sufijo '@'.
{
  "tagOwners": {
    "tag:orchestrator": ["tfm-oob@"],
    "tag:dc":           ["tfm-oob@"],
    "tag:analyst":      ["tfm-oob@"],
    "tag:kvm":          ["tfm-oob@"],
  },

   "acls": [
    { "action": "accept", "src": ["tag:orchestrator"], "dst": ["tag:dc:8000"] },

    // El analista se conecta al servidor de rendezvous del enclave, no al
    // endpoint: RustDesk es un protocolo mediado y ambos extremos acuden a
    // hbbs/hbbr. La regla inicial (tag:analyst -> tag:dc:21115-21119) partía
    // de una topología equivocada, ya que el cliente del DC no escucha en
    // esos puertos.
    { "action": "accept", "src": ["tag:analyst"], "dst": ["tag:orchestrator:21115-21119,22"] },

    { "action": "accept", "src": ["tag:analyst"], "dst": ["tag:kvm:443,80,22"] },

    // Excepción acotada al principio "el DC nunca es origen":
    // el cliente RustDesk debe registrarse contra el servidor de
    // rendezvous del enclave. Limitado a los puertos de señalización
    // y relay; no habilita ningún otro destino.
    { "action": "accept", "src": ["tag:dc"], "dst": ["tag:orchestrator:21115-21119"] },
  ],
}
