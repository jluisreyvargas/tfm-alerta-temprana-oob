# Copiar a .env en este mismo directorio. Excluido por .gitignore (**/.env).
#
# Credenciales root de MinIO. Se dejan VACÍAS a propósito: al no existir .env,
# docker-compose aplicaba el valor por defecto definido en el propio compose y
# la credencial documentada era la credencial en uso, publicada en el
# repositorio (P0-3). El compose aborta ahora con :? si la variable falta.
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
MINIO_BUCKET=evidence
VELOCIRAPTOR_API=https://velociraptor:8001
VELOCIRAPTOR_GUI=https://velociraptor:8889
IRIS_URL=https://iris.oob.local:4833
IRIS_API_KEY=change_me
