# Copiar a .env. Excluido por .gitignore (**/.env).

# Motor de triage: deterministic | llm | hybrid
TRIAGE_MODE=deterministic

# Credenciales del indexador de metricas (Fase 7).
# La version anterior llevaba la contrasena por defecto publica del indexador
# escrita en el compose, que esta publicado en el repositorio.
OS_USER=admin
OS_PASS=
