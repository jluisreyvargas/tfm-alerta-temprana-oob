fase4-breakglass-dc/headscale/lib/
fase4-breakglass-dc/rustdesk/data/

# Velociraptor generated artifacts
*.log
*.tidx

fase2-orquestador/n8n/wf-backup-*.json
fase2-orquestador/n8n/cred-inventory.json
fase2-orquestador/n8n/wf-FUNCIONANDO*.json

fase5-velociraptor/velociraptor-config/client_info/
fase5-velociraptor/velociraptor-config/logs/
fase5-velociraptor/velociraptor-config/server_artifact_logs/
fase5-velociraptor/velociraptor-config/server_artifacts/
fase5-velociraptor/velociraptor-config/clients/*/monitoring/
fase5-velociraptor/velociraptor-config/clients/*/monitoring_logs/
fase5-velociraptor/velociraptor-config/clients/*/tasks/
fase5-velociraptor/velociraptor-config/config/*.json.db
fase5-velociraptor/velociraptor-config/users/*/Notifications.json*

# KVM database
fase8-kvm/glkvm-cloud/docker-compose/database/*.db*

# Fichero auxiliar de la prueba de humo del banco de pruebas de Fase 3;
# no aporta nada al repositorio como evidencia del TFM.
fase3-agentic/bench/una_alerta.json
# Secretos y material criptográfico: nunca se commitean
**/.env
**/*.key
**/*.pem
**/certificate/

# Exportaciones de trabajo de n8n. Contienen referencias a credenciales por ID
# y estructura interna de la instancia; el workflow versionado y saneado vive en
# fase2-orquestador/n8n/workflows/
fase2-orquestador/n8n/*.json
!fase2-orquestador/n8n/workflows/*.json

# Claves privadas de la CA del enclave. El certificado y el CA son publicos;
# las claves nunca se versionan.
fase1-infraestructura/traefik/certs/*.key
fase1-infraestructura/traefik/certs/*.srl
fase4-breakglass-dc/.env

# Fase 8 — material criptográfico del KVM
fase8-kvm/glkvm-cloud/docker-compose/certificate/glkvm.cer
fase8-kvm/glkvm-cloud/docker-compose/certificate/glkvm.key

# Fase 4d — inventario de peers generado en runtime.
# Lo regenera export-peers.sh por cron cada 30 min; es estado, no configuración.
fase4-breakglass-dc/rustdesk/peers.json

# Fase 4 — copias de trabajo del plano de control (no son la configuración viva).
fase4-breakglass-dc/headscale/config/config.yaml.rollback-inseguro
fase4-breakglass-dc/headscale/config/config.yaml.endurecido-completo
fase4-breakglass-dc/headscale/config/*.bak
fase4-breakglass-dc/headscale/config/*.bak-*

# ─── Fase 5 · Velociraptor ────────────────────────────────────────────────
# Añadido en la remediación P0-1. El estado de runtime del servidor contiene
# la clave privada de la CA, las claves del frontend y del gateway de la GUI,
# el obfuscation_nonce y los hashes de los usuarios de la GUI. Nada de esto
# puede volver al repositorio. Ver SECURITY-NOTICE.md.

# Estado de runtime completo del servidor
fase5-velociraptor/velociraptor-config/*
!fase5-velociraptor/velociraptor-config/.gitkeep

# Configuraciones reales: en el repositorio viven solo las plantillas
fase5-velociraptor/**/server.config.yaml
fase5-velociraptor/**/client.config.yaml
fase5-velociraptor/**/client.root.config.yaml
fase5-velociraptor/**/api_client.yaml

# Instaladores empaquetados: llevan la configuración de cliente embebida
fase5-velociraptor/installer-windows/
*.msi

# Directorio huérfano (no está montado en el compose)
fase5-velociraptor/velociraptor/

# ─── Fase 6 · DFIR-IRIS ───────────────────────────────────────────────────
# Material de PKI. Los certificados que trae la imagen son de desarrollo y
# su clave privada es pública (repositorio oficial de DFIR-IRIS). No deben
# versionarse ni usarse en despliegue. Ver P0-2.
fase6-iris/certificates/rootCA/
fase6-iris/certificates/web_certificates/

# Evidencia P0-C Fase 6: CA demo pública de DFIR-IRIS extraída del contenedor.
# Certificado público, sin clave privada. Excepción puntual a **/*.pem.
!docs/evidencias/fase6-p0c/irisRootCACert-demo.pem

# Copias de seguridad de ficheros de entorno creadas durante remediaciones.
# La regla **/.env no las cubre por el sufijo.
**/.env.pre-*
**/.env.bak
**/.env.*.bak
