# Copiar a dc-signed.env en este mismo directorio (scripts/). Ignorado por git
# (ver .gitignore: scripts/dc-signed.env). Valores vacios a proposito (leccion
# del P0-3): un placeholder puede usarse tal cual y producir una mala
# configuracion silenciosa; un valor vacio obliga a asignarlo, y si no se
# asigna, dc-signed.sh aborta con un error explicito en vez de arrancar con
# una credencial conocida.

# URL base del agente del DC (fase4-breakglass-dc/dcagent/agent_dc.py),
# ej. http://100.64.0.2:8000 . Solo alcanzable dentro de la tailnet Headscale.
AGENT_URL=

# Bearer token compartido con el agente (variable AGENT_TOKEN en su entorno
# de servicio — ver fase4-breakglass-dc/dcagent/README-despliegue.md).
AGENT_TOKEN=

# Secreto HMAC-SHA256 compartido (variable AGENT_HMAC_SECRET en su entorno de
# servicio). Obligatorio si el agente corre con AGENT_REQUIRE_HMAC=true.
AGENT_HMAC_SECRET=
