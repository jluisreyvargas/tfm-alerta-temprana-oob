# Copiar a .env en este mismo directorio. Excluido por .gitignore (**/.env).
#
# Contraseña del usuario admin del indexador de Wazuh (Fase 7 - métricas).
# La versión anterior llevaba la contraseña por defecto pública del indexador
# escrita en el compose, que está publicado en el repositorio. Debe coincidir
# con INDEXER_PASSWORD configurado en fase1-infraestructura/wazuh/single-node/.env.

OS_PASS=

# Credenciales de MinIO para el orchestrator (bucket evidence).
# La versión anterior no traía .env, así que docker-compose aplicaba el valor
# por defecto definido en el propio compose y la credencial documentada era la
# credencial en uso; quedó publicada en el repositorio (P0-3).
# El orchestrator usa ahora el usuario dedicado tfm-orchestrator con la
# política evidence-writer (sin s3:DeleteObject), NO las credenciales root.

MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
