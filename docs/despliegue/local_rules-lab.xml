<!-- Example -->
<group name="local,syslog,sshd,">
  <!--
  Dec 10 01:02:02 host sshd[1234]: Failed none for root from 1.1.1.1 port 1066 ssh2
  -->
  <rule id="100001" level="5">
    <if_sid>5716</if_sid>
    <srcip>1.1.1.1</srcip>
    <description>sshd: authentication failed from IP 1.1.1.1.</description>
    <group>authentication_failed,pci_dss_10.2.4,pci_dss_10.2.5,</group>
  </rule>
</group>

<!-- TFM - Fase 4: auditoria del canal break-glass sobre el DC.
     Los eventos proceden del agente Python desplegado en dc01-tfm.
     La regla base filtra por origen (location) en lugar de por decoder,
     ya que el log es texto plano sin formato reconocido por los decoders
     nativos de Windows. -->
<group name="tfm,breakglass,">

  <rule id="100600" level="0">
    <location>tfm-dc-agent</location>
    <description>TFM DC Agent - evento base</description>
  </rule>

  <rule id="100601" level="5">
    <if_sid>100600</if_sid>
    <match>EJECUCION script=</match>
    <description>TFM Break-glass: ejecucion de script en DC</description>
    <group>gdpr_IV_35.7.d,pci_dss_10.2.7,</group>
  </rule>

  <rule id="100602" level="10">
    <if_sid>100601</if_sid>
    <match>script=isolate_host.ps1</match>
    <description>TFM Break-glass: aislamiento de host solicitado en DC</description>
  </rule>

  <rule id="100603" level="10">
    <if_sid>100601</if_sid>
    <match>script=rustdesk_enable.ps1</match>
    <description>TFM Break-glass: activacion de acceso remoto en DC</description>
  </rule>

  <rule id="100604" level="12">
    <if_sid>100600</if_sid>
    <match>Token invalido</match>
    <description>TFM Break-glass: token invalido en el agente del DC</description>
  </rule>

  <rule id="100605" level="12">
    <if_sid>100600</if_sid>
    <match>Bad signature</match>
    <description>TFM Break-glass: firma HMAC invalida en el agente del DC</description>
  </rule>

  <rule id="100606" level="12">
    <if_sid>100600</if_sid>
    <match>Replay detectado</match>
    <description>TFM Break-glass: replay detectado en el agente del DC</description>
  </rule>

  <rule id="100607" level="8">
    <if_sid>100600</if_sid>
    <match>Script rechazado</match>
    <description>TFM Break-glass: script fuera de allowlist rechazado</description>
  </rule>

  <rule id="100608" level="8">
    <if_sid>100600</if_sid>
    <match>Target invalido</match>
    <description>TFM Break-glass: parametro target rechazado por validacion</description>
  </rule>

  <rule id="100609" level="8">
    <if_sid>100600</if_sid>
    <match>Ruta de script invalida</match>
    <description>TFM Break-glass: intento de path traversal rechazado</description>
  </rule>

  <rule id="100610" level="13" frequency="5" timeframe="120">
    <if_matched_sid>100604</if_matched_sid>
    <description>TFM Break-glass: multiples intentos de acceso no autorizado</description>
  </rule>

</group>
