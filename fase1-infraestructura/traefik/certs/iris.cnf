[req]
distinguished_name = dn
req_extensions     = ext
prompt             = no

[dn]
C  = ES
O  = TFM Enclave OOB
OU = Seguridad
CN = iris.oob.local

[ext]
subjectAltName   = @alt
keyUsage         = critical, digitalSignature, keyEncipherment
extendedKeyUsage = serverAuth

[alt]
DNS.1 = iris.oob.local
DNS.2 = iris.local
DNS.3 = localhost
IP.1  = 127.0.0.1
IP.2  = 192.168.127.138
