ENCLAVE_DOMAIN=oob.local
# No la lee ningun compose: Let's Encrypt nunca se desplego (oob.local no es
# resoluble publicamente). Se conserva por compatibilidad.
ACME_EMAIL=tu@email.com

# Etiqueta y digest de la imagen validada en el laboratorio
# (docs/despliegue/imagenes-validadas-2026-11-10.txt). El compose compone
# registry.rocket.chat/rocketchat/rocket.chat:${ROCKETCHAT_VERSION}, asi que el
# digest va aqui. La etiqueta se conserva para que se lea la version.
ROCKETCHAT_VERSION=8.4.3@sha256:aa2ef01551d1df3595b4765df94cf8a46fbb5ad21fd00035f387c1c8a72915dd
# URL publica de Rocket.Chat. La lee docker-compose.yml (ROOT_URL del servicio
# rocketchat). Debe ser https://chat.<ENCLAVE_DOMAIN>.
ROOT_URL=https://chat.oob.local
# No las lee ningun compose: en Rocket.Chat 8.x estas variables ya no crean el
# administrador (docs/README-fase1c-mongodb-rocketchat.md, "Problema 6").
ROCKETCHAT_ADMIN_USER=rc_admin
ROCKETCHAT_ADMIN_PASS=
ROCKETCHAT_ADMIN_EMAIL=admin@tudominio.com
MONGO_INITDB_ROOT_USERNAME=rcuser
MONGO_INITDB_ROOT_PASSWORD=

# Generar cada secreto con: openssl rand -hex 32
# Vacios a proposito: un placeholder de longitud suficiente arranca igual y
# sobrevive al despliegue. El vacio impide que Authelia levante.
AUTHELIA_JWT_SECRET=
AUTHELIA_SESSION_SECRET=
AUTHELIA_STORAGE_ENCRYPTION_KEY=

# No la lee ningun compose: la imagen de Portainer va escrita en
# docker-compose.yml, fijada por digest.
PORTAINER_VERSION=latest
