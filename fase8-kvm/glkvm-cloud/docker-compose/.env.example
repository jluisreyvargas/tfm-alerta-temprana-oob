# Plantilla del proyecto TFM para la plataforma KVM (rttys). Copiar a .env en
# este mismo directorio. Excluido por .gitignore (**/.env).
#
# NO es la plantilla del upstream: .env.arm64.example se conserva sin tocar y
# no sirve para este despliegue (imagenes arm64, proxy inverso desactivado,
# puerto 443 y secretos de ejemplo publicos). Ver
# docs/despliegue/INVENTARIO-despliegue.md, seccion 1.8.
#
# Los cuatro valores marcados OBLIGATORIO se dejan VACIOS a proposito. Atencion:
# si faltan, docker-compose.yml NO aborta; cae a constantes publicas del
# upstream (docker-compose.yml:10-11,20). Un .env incompleto arranca y funciona
# con credencial conocida.

# --- Imagen ------------------------------------------------------------------

# Valor por defecto del compose para amd64 (docker-compose.yml:3). No tiene
# efecto mientras exista docker-compose.override.yml, que fija la imagen por
# digest (docker-compose.override.yml:5). COTURN_IMAGE no se define: el servicio
# coturn esta desactivado por perfil (docker-compose.override.yml:17-23).
GLKVM_IMAGE=glzhitong/glkvm-cloud:latest

# --- Proxy inverso -----------------------------------------------------------

# rttys va en claro detras de Traefik, que termina TLS
# (docs/credenciales-de-arranque.md:92; docker-compose.yml:51 y :82-84).
REVERSE_PROXY_ENABLED=true

# Sin evidencia en el repositorio de que el despliegue los fije. Vacios = valor
# por defecto del upstream (deteccion por cabeceras X-Forwarded-*).
SELFHOST_WEBUI_URL=
DEVICE_ENDPOINT_HOST=
WEB_UI_HOST=

# --- Red ---------------------------------------------------------------------

# OBLIGATORIO. IP de la interfaz LAN por la que llega el GL-RM1; la misma en la
# que docker-compose.override.yml publica el 5912 y el 10443 (:14-15).
# Vacio hace que el entrypoint consulte servicios de Internet y caiga a
# 127.0.0.1 (fase8-kvm/README.md:229-237).
GLKVM_ACCESS_IP=

# --- rttys -------------------------------------------------------------------

# OBLIGATORIO. Token de registro del dispositivo. Generable. Debe coincidir con
# TOKEN en /etc/kvmd/user/scripts/S01selfCloud del GL-RM1 (fase8-kvm/README.md:195).
RTTYS_TOKEN=

# OBLIGATORIO. Contrasena del administrador de rttys. Generable.
RTTYS_PASS=

# Vacio = "admin" (docs/api-reconocimiento-fase8.md:285). Solo letras y digitos.
RTTYS_ADMIN_NAME=

# Puerto del dispositivo: el que publica el override (docker-compose.override.yml:14).
RTTYS_DEVICE_PORT=5912
# Puerto de la interfaz web en claro: el que espera la etiqueta de Traefik del
# router kvm (docker-compose.yml:81) y los nodos del workflow kvm-hook.
RTTYS_WEBUI_PORT=8180
# Puerto del proxy /web/ del dispositivo: el que publica el override (:15) y
# espera la etiqueta de Traefik del router kvmproxy (docker-compose.yml:90).
RTTYS_HTTP_PROXY_PORT=10443

# --- TURN --------------------------------------------------------------------

# coturn esta desactivado, pero rttys sigue recibiendo estos valores y el
# GL-RM1 los lleva en S01selfCloud (fase8-kvm/README.md:196-199).
TURN_PORT=3478
TURN_USER=glkvmcloudwebrtcuser
# OBLIGATORIO. Generable. Debe coincidir con WEBRTC_PASSWORD en S01selfCloud
# del GL-RM1 (fase8-kvm/README.md:199).
TURN_PASS=

# --- LDAP / OIDC -------------------------------------------------------------

# Desactivados: el enclave no depende del directorio corporativo.
LDAP_ENABLED=false
OIDC_ENABLED=false
